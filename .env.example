DATABASE_URL=postgresql://chatapp:YOUR_DB_PASSWORD@localhost:5432/chatapp
REDIS_URL=redis://localhost:6379
SESSION_SECRET=YOUR_LONG_RANDOM_SESSION_SECRET

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chatapp
S3_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
S3_SECRET_KEY=YOUR_MINIO_SECRET_KEY

VITE_API_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password

WEB_PUSH_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
WEB_PUSH_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY

# ==============================================================================
# Production Replacement Guidance:
# Replace localhost with your real server/domain values:
# DATABASE_URL   → PostgreSQL server (e.g. postgresql://chatapp:PROD_PASS@db.yourdomain.com:5432/chatapp)
# REDIS_URL      → Redis server (e.g. redis://redis.yourdomain.com:6379)
# S3_ENDPOINT    → https://storage.yourdomain.com
# VITE_API_URL   → https://api.yourdomain.com/api/v1
# VITE_SOCKET_URL → https://api.yourdomain.com
#
# Do not invent the database password, S3 keys, SMTP credentials, or VAPID keys.
# Those must be generated/configured on the actual servers.
#
# For the unlimited-connections requirement, there is no UNLIMITED_CONNECTIONS=true value.
# The backend should have no artificial application connection cap; actual capacity is determined
# by the server infrastructure.
# ==============================================================================
